APP_ENV=development
APP_TITLE=YanShu Backend API
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8001
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://yanshu_app:REPLACE_APP_PASSWORD@127.0.0.1:55432/yanshu

# Optional local voiceprint enrollment. Generate with scripts/setup_voiceprint_local.py.
# Never reuse JWT_SECRET or store this key in database backups.
VOICEPRINT_KEY=
VOICEPRINT_KEY_ID=local-v1
TEST_DATABASE_URL=postgresql+psycopg://yanshu_app:REPLACE_APP_PASSWORD@127.0.0.1:55432/yanshu_auth_test
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PG_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_APP_PASSWORD
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_WORKERS_ENABLED=false
# 实测实时增量未加速时保留主模型，其他 Worker 可独立使用 MiniMax。
MINIMAX_REALTIME_ENABLED=false
# 实时默认不增加推理；复杂复核可单独设 low/medium/high，需测量延迟。
HERMES_REVIEW_REASONING_EFFORT=none
HERMES_RUNTIME_PATH=E:/PythonProject/hermes-agent
HERMES_TIMEOUT_SECONDS=90
# 本地默认保留 LlamaIndex 检索；启用独立 QMD 后仅填写本机回环地址。
DOCUMENT_ACTIONS_ENABLED=true
QMD_URL=
QMD_TIMEOUT_SECONDS=10

# 腾讯云实时语音识别 V2，仅后端保存凭据；不录入 Flutter。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_en_2.0
ASR_MAX_STREAM_SECONDS=7200

# 极光 Android 推送：Master Secret 只保存在服务端。iOS APNs 暂未配置。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# 会前准备默认关闭，只处理带 verified_at 的新权威日程；不会补发迁移前历史。
MEETING_PREPARATION_ENABLED=false
# 到达 sendAt 后允许的停机补偿窗口，范围 1-120 分钟。
MEETING_PREPARATION_RECOVERY_MINUTES=15
